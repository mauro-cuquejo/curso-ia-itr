# ========================================
# ITR Dashboard App - Variables de Entorno
# ========================================

# ===============================
# CONFIGURACIÓN DEL BACKEND
# ===============================

# Puerto del servidor backend
PORT=5000

# Entorno de ejecución
NODE_ENV=development

# Configuración JWT
JWT_SECRET=itr_dashboard_secret_super_seguro_2024_desarrollo
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Base de datos SQLite
DB_PATH=./backend/database/app.db

# ===============================
# CONFIGURACIÓN DEL FRONTEND
# ===============================

# URL base de la API para React
REACT_APP_API_URL=http://localhost:5000/api

# Nombre de la aplicación
REACT_APP_APP_NAME=ITR Dashboard

# Variables adicionales para React
GENERATE_SOURCEMAP=false
SKIP_PREFLIGHT_CHECK=true
FAST_REFRESH=true

# ===============================
# CONFIGURACIÓN DE DESARROLLO
# ===============================

# Configuración de CORS
FRONTEND_URL=http://localhost:3000

# Configuración de logging
LOG_LEVEL=debug

# Configuración de rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===============================
# CONFIGURACIÓN DE BASE DE DATOS
# ===============================

# Configuración SQLite específica
DB_LOGGING=true
DB_SYNC_FORCE=false
DB_SYNC_ALTER=true

# ===============================
# CONFIGURACIÓN DE SEGURIDAD
# ===============================

# Bcrypt rounds
BCRYPT_SALT_ROUNDS=12

# Session configuration
SESSION_SECRET=itr_session_secret_desarrollo_2024
SESSION_MAX_AGE=86400000

# ===============================
# CONFIGURACIÓN DE ARCHIVOS
# ===============================

# Límites de archivos
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif

# ===============================
# CONFIGURACIÓN AUTOMÁTICA
# ===============================

# Auto-start servers
AUTO_START_BACKEND=true
AUTO_START_FRONTEND=true
OPEN_BROWSER=true

# Configuración de puertos alternativos
BACKEND_PORT_FALLBACK=5001,5002,5003
FRONTEND_PORT_FALLBACK=3001,3002,3003

# ===============================
# INSTRUCCIONES RÁPIDAS
# ===============================

# 1. Copia este archivo como .env: cp env.example .env
# 2. Ejecuta el proyecto completo: npm run dev
# 3. Backend: http://localhost:5000
# 4. Frontend: http://localhost:3000
