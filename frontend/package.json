
{
  "name": "itr-dashboard-frontend",
  "version": "1.0.0",
  "description": "ITR Dashboard Frontend - Aplicación React con Material-UI y Redux",
  "homepage": ".",
  "private": true,
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-scripts": "5.0.1",
    "@reduxjs/toolkit": "2.2.7",
    "react-redux": "9.1.2",
    "redux": "5.0.1",
    "axios": "1.7.7",
    "@mui/material": "6.1.1",
    "@mui/icons-material": "6.1.1",
    "@mui/lab": "6.0.0-beta.10",
    "@mui/x-data-grid": "7.18.0",
    "@emotion/react": "11.13.3",
    "@emotion/styled": "11.13.0",
    "react-router-dom": "6.26.2",
    "react-hook-form": "7.53.0",
    "yup": "1.4.0",
    "@hookform/resolvers": "3.9.0",
    "framer-motion": "11.11.1",
    "date-fns": "4.1.0"
  },
  "devDependencies": {
    "@types/react": "18.3.8",
    "@types/react-dom": "18.3.0",
    "typescript": "4.9.5",
    "@testing-library/react": "16.0.1",
    "@testing-library/jest-dom": "6.5.0",
    "@testing-library/user-event": "14.5.2",
    "eslint": "8.57.1",
    "prettier": "3.3.3"
  },
  "scripts": {
    "start": "SKIP_PREFLIGHT_CHECK=true react-scripts start",
    "build": "SKIP_PREFLIGHT_CHECK=true react-scripts build",
    "test": "SKIP_PREFLIGHT_CHECK=true react-scripts test",
    "eject": "react-scripts eject",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write src/**/*.{js,jsx,ts,tsx,css,scss,json}",
    "type-check": "tsc --noEmit"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "no-console": "warn",
      "no-unused-vars": "warn"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "http://localhost:5000",
  "engines": {
    "node": "20.17.0",
    "npm": "10.8.2"
  }
}
